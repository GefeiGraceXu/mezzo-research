---
import Base from '../layouts/Base.astro';
import { site } from '../config/site.js';
---

<Base title="关于">
  <a class="back" href="/">← 返回首页</a>

  <div class="page-head">
    <h1>关于</h1>
  </div>

  <div class="prose" style="max-width: 680px">
    <p>
      {site.title} 是我的个人研究记录：把看过的行业、读过的资料、想明白的事写下来，
      顺便长期跟踪一些数据。
    </p>
    <p>这里的内容都是个人学习笔记，不构成任何投资建议。</p>
  </div>
</Base>
